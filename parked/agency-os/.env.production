# ============================================================
# Agency OS — Vercel Production Environment Variables
# Copy each of these into your Vercel project settings:
# https://vercel.com/[your-team]/agency-os/settings/environment-variables
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=<SET_AT_ACTIVATION_from_Sapient_Supabase_project>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SET_AT_ACTIVATION_from_Sapient_Supabase_project>
SUPABASE_SERVICE_ROLE_KEY=<SET_AT_ACTIVATION_from_Sapient_Supabase_project>

# App URL — update after Vercel assigns domain
NEXT_PUBLIC_APP_URL=https://agency.sapientdigital.io

# AI
ANTHROPIC_API_KEY=<SET_AT_ACTIVATION>

# Email
RESEND_API_KEY=<SET_AT_ACTIVATION>
RESEND_FROM_EMAIL=noreply@sapientdigital.io
RESEND_FROM_NAME=Sapient Digital

# Video pipeline
HIGGSFIELD_API_KEY_ID=<SET_AT_ACTIVATION>
HIGGSFIELD_API_KEY_SECRET=<SET_AT_ACTIVATION>
HEYGEN_API_KEY=<SET_AT_ACTIVATION>
ELEVEN_LABS_API_KEY=<SET_AT_ACTIVATION>
VIMEO_PERSONAL_API_TOKEN=<SET_AT_ACTIVATION>
VIMEO_APP_ID=<SET_AT_ACTIVATION>

# n8n
N8N_API_KEY=<SET_AT_ACTIVATION>
N8N_BASE_URL=https://n8n.srv816212.hstgr.cloud
N8N_VIDEO_PIPELINE_WEBHOOK=https://n8n.srv816212.hstgr.cloud/webhook/sapient-video-trigger
